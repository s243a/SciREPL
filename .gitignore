# Generated files
node_modules/
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/release-signing.properties
.DS_Store

# Signing keys (NEVER commit these!)
*.keystore
*.jks
signing/

# IDE
.idea/
*.iml
.vscode/

# Capacitor
.capacitor/
android/capacitor-cordova-android-plugins/

# Rust build artifacts
tests/*/target/
tests/*/Cargo.lock

# Logs
*.log
npm-debug.log*

# Playwright runner state
test-results/

# Bundled kernel runtimes (build artifacts fetched by scripts/fetch-bundles.mjs)
www/vendor/pyodide/
www/vendor/swipl/
www/vendor/scittle/
www/vendor/webr/

# Windows/Electron shell (desktop/electron). The downloaded Electron runtime
# lives under its own node_modules/ (already ignored above); these are the
# packaging output and test artifacts, which must never be committed.
desktop/electron/dist/
desktop/electron/out/
desktop/electron/release/
desktop/electron/test/results/

# Python bytecode from the locale build scripts
__pycache__/
*.pyc
