{
  "$comment": "Build-profile source of truth. Per-language component IDs point into third-party-components.json, which owns exact runtime versions and pinned source/mirror URLs. configure-build.mjs combines the two files into www/js/kernel_config.js. Profiles select which languages are enabled and bundled offline; fetch-bundles.mjs downloads bundled runtimes into www/vendor/<lang>/ for Capacitor/Electron/PWA packaging. Free defaults to full (R downloaded on first use); Pro defaults to pro (R bundled offline).",
  "default": "full",
  "languages": {
    "javascript": { "runtime": "native", "timeoutMs": 0 },
    "bash":       { "component": "brush", "runtime": "local", "timeoutMs": 0 },
    "typr":       { "component": "typr", "runtime": "local", "timeoutMs": 0 },
    "lua":        { "component": "fengari", "runtime": "cdn", "timeoutMs": 30000 },
    "clojurescript": { "component": "scittle", "runtime": "cdn", "timeoutMs": 30000, "localUrl": "vendor/scittle/scittle.js" },
    "prolog":     { "component": "swipl-wasm", "runtime": "cdn", "timeoutMs": 60000, "localUrl": "vendor/swipl/dynamic-import.js" },
    "python":     { "component": "pyodide", "runtime": "cdn", "timeoutMs": 120000, "localUrl": "vendor/pyodide/pyodide.js" },
    "r":          { "component": "webr-support", "runtime": "cdn", "timeoutMs": 180000, "localUrl": "vendor/webr/webr.mjs" }
  },
  "profiles": {
    "mini":  { "enabled": ["javascript", "bash", "typr", "lua"] },
    "light": { "enabled": ["javascript", "bash", "typr", "lua", "clojurescript", "prolog", "python"], "bundle": ["clojurescript"] },
    "full":  { "enabled": ["javascript", "bash", "typr", "lua", "clojurescript", "prolog", "python", "r"], "bundle": ["prolog", "python", "clojurescript"] },
    "pro":   { "enabled": ["javascript", "bash", "typr", "lua", "clojurescript", "prolog", "python", "r"], "bundle": ["prolog", "python", "clojurescript", "r"] }
  }
}
