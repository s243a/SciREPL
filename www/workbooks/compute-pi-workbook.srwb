    "name": "Compute Pi: Archimedean Method",
    "cells": [
      {
        "type": "code",
        "code": "import numpy as np\n\n# Unit circle\ntheta = np.linspace(0, 2*np.pi, 100)\nx_circle = np.cos(theta)\ny_circle = np.sin(theta)\n\n# Regular hexagon vertices (6 points)\nn = 6\nangles = np.linspace(0, 2*np.pi, n, endpoint=False)\nx_hex = np.cos(angles)\ny_hex = np.sin(angles)\n# Close the hexagon by repeating the first point\nx_hex = np.append(x_hex, x_hex[0])\ny_hex = np.append(y_hex, y_hex[0])\n\n# Lines from center to each vertex\nlines_x = []\nlines_y = []\nfor i in range(n):\n    lines_x.extend([0, x_hex[i], None])\n    lines_y.extend([0, y_hex[i], None])\n\n# Create traces\ncircle_trace = {\"x\": x_circle, \"y\": y_circle, \"mode\": \"lines\", \"name\": \"Unit Circle\", \"line\": {\"color\": \"blue\"}}\nhex_trace = {\"x\": x_hex, \"y\": y_hex, \"mode\": \"lines+markers\", \"name\": \"Hexagon\", \"line\": {\"color\": \"red\"}, \"marker\": {\"size\": 8}}\nlines_trace = {\"x\": lines_x, \"y\": lines_y, \"mode\": \"lines\", \"name\": \"Radii\", \"line\": {\"color\": \"green\", \"dash\": \"dash\"}}\n\n# Layout with equal aspect ratio\nlayout = {\n    \"title\": \"Regular Hexagon Inscribed in Unit Circle\",\n    \"yaxis\": {\"scaleanchor\": \"x\", \"scaleratio\": 1},\n    \"xaxis\": {\"title\": \"x\"},\n    \"yaxis\": {\"title\": \"y\", \"scaleanchor\": \"x\"},\n    \"showlegend\": True\n}\n\nmplot([circle_trace, hex_trace, lines_trace], layout=layout)",
        "language": "python",
        "name": ""
      },
      {
        "type": "code",
        "code": "import numpy as np\n\n# Geometry calculations\nn = 6  # hexagon\nr = 1  # unit circle\n\n# Area of one equilateral triangle (center + 2 adjacent vertices)\n# Each triangle has two sides = r (radii) and angle between them = 2π/n\nangle = 2 * np.pi / n  # central angle = 60 degrees = π/3\n\n# Area of one triangle = (1/2) * r^2 * sin(central_angle)\narea_triangle = 0.5 * r**2 * np.sin(angle)\n\n# Total hexagon area = 6 * area of one triangle\narea_hexagon = n * area_triangle\n\n# Area of unit circle\narea_circle = np.pi * r**2\n\n# Area between circle and hexagon (the \"gaps\")\narea_between = area_circle - area_hexagon\n\nprint(\"=\" * 50)\nprint(\"AREA CALCULATIONS FOR REGULAR HEXAGON IN UNIT CIRCLE\")\nprint(\"=\" * 50)\nprint(f\"\\n1. Area of one equilateral triangle:\")\nprint(f\"   Formula: (1/2) * r² * sin(2π/6) = (1/2) * sin(π/3)\")\nprint(f\"   Value:   {area_triangle:.6f} = √3/4 ≈ 0.433013\")\n\nprint(f\"\\n2. Area of hexagon (6 triangles):\")\nprint(f\"   Formula: 6 * (1/2) * r² * sin(π/3) = (3√3)/2\")\nprint(f\"   Value:   {area_hexagon:.6f} ≈ 2.598076\")\n\nprint(f\"\\n3. Area of unit circle:\")\nprint(f\"   Formula: π * r² = π\")\nprint(f\"   Value:   {area_circle:.10f}\")\n\nprint(f\"\\n4. Area between circle and hexagon:\")\nprint(f\"   Value:   {area_between:.6f} ≈ {np.pi - 3*np.sqrt(3)/2:.6f}\")\n\nprint(\"\\n\" + \"=\" * 50)\nprint(\"KEY INSIGHT: LOWER BOUND FOR π\")\nprint(\"=\" * 50)\nprint(f\"\\nHexagon area = 3√3/2 = {3*np.sqrt(3)/2:.6f}\")\nprint(f\"Circle area  = π       = {np.pi:.6f}\")\nprint(f\"\\nSince hexagon is INSIDE the circle:\")\nprint(f\"   hexagon_area < circle_area\")\nprint(f\"   3√3/2 < π\")\nprint(f\"\\nTherefore: π > 3√3/2 ≈ {3*np.sqrt(3)/2:.6f}\")\nprint(f\"             π ≈ {np.pi:.6f}\")\nprint(f\"\\nThis gives us a LOWER BOUND for π using inscribed polygons!\")\n",
        "language": "python",
        "name": ""
      },
      {
        "type": "code",
        "code": "import numpy as np\nfrom sympy import *\n\n# Symbolic representation of the formula\nprint(\"SYMBOLIC FORMULA FOR π APPROXIMATION\")\nprint(\"=\" * 70)\nprint()\nprint(\"The area of a regular N-gon inscribed in a unit circle:\")\nprint()\n\n# Create symbolic variables\nN, pi_sym = symbols('N pi', positive=True, real=True)\n\n# Symbolic formula for inscribed polygon area\ninscribed_formula = (N/2) * sin(2*pi_sym/N)\n\nprint(\"Symbolic formula:\")\nprint(f\"  Area = (N/2) × sin(2π/N)\")\nprint()\nprint(\"For a unit circle, π is the limiting value:\")\nprint(\"  π = lim(N→∞) (N/2) × sin(2π/N)\")\nprint()\n\n# Show using SymPy limit\nn_sym = symbols('n', positive=True, integer=True)\nlimit_expr = limit((n_sym/2) * sin(2*pi/n_sym), n_sym, oo)\nprint(f\"  lim(n→∞) (n/2)·sin(2π/n) = {limit_expr}\")\nprint()\nprint(\"-\" * 70)\nprint()\n\n# Actual numerical computation for required N\nprint(\"DETERMINING N FOR d DIGITS OF ACCURACY\")\nprint(\"=\" * 70)\nprint()\nprint(\"Goal: Find N such that |π - (N/2)·sin(2π/N)| < 10^(-d)\")\nprint()\n\ndef inscribed_area(N):\n    return (N / 2) * np.sin(2 * np.pi / N)\n\ndef find_N_for_digits(d):\n    \"\"\"Find minimum N such that error < 10^(-d)\"\"\"\n    target_error = 10**(-d)\n    # Start with estimated N based on asymptotic formula\n    # Error ≈ (2/3) * π³ / N² for large N\n    # N ≈ sqrt((2/3) * π³ * 10^d) ≈ 4.55 * 10^(d/2)\n    N_est = int(np.ceil(4.55 * np.sqrt(10**d)))\n    N_est = max(N_est, 3)  # At least 3 sides\n    \n    # Search upward until error is small enough\n    N = N_est\n    while True:\n        approx = inscribed_area(N)\n        error = abs(np.pi - approx)\n        if error < target_error:\n            return N, approx, error\n        N += 1\n        # Safety check\n        if N > 10000000:\n            return None, None, None\n\n# Compute for d = 1 to 10\npi_str = \"3.14159265358979323846\"\nprint(f\"{'d':>4} {'Required N':>12} {'Approximation':>20} {'Error':>12} {'Correct Digits':>16}\")\nprint(\"-\" * 70)\n\nresults = []\nfor d in range(1, 11):\n    N_needed, approx, error = find_N_for_digits(d)\n    approx_str = f\"{approx:.15f}\"\n    \n    # Count correct digits\n    correct = 0\n    for i, (a, p) in enumerate(zip(approx_str, pi_str)):\n        if i == 1:  # Skip the decimal point\n            continue\n        if a == p:\n            correct += 1\n        else:\n            break\n    \n    results.append((d, N_needed, approx, error, correct))\n    print(f\"{d:>4} {N_needed:>12} {approx:>20.10f} {error:>12.2e} {correct:>16}\")\n\nprint(\"-\" * 70)\nprint()\nprint(\"KEY INSIGHT:\")\nprint(\"  To get d digits of π, you need approximately N ≈ 4.5 × 10^(d/2) sides\")\nprint(\"  This means N grows exponentially with the number of digits!\")\nprint()\nprint(\"  For Archimedes (d ≈ 2 using N = 96):\")\nprint(f\"    Approximation: {inscribed_area(96):.6f}\")\nprint(f\"    π =            {np.pi:.6f}\")\nprint()\n\n# Display the symbolic formula in LaTeX\ninscribed_formula\n",
        "language": "python",
        "name": ""
      },
      {
        "type": "code",
        "code": "import numpy as np\n\n# True value of pi for comparison\nPI_TRUE = \"3.14159265358979323846264338327950288419716939937510\"\n\ndef get_digit(number, position):\n    \"\"\"Extract the digit at a given decimal position (1=first digit after decimal)\"\"\"\n    number_str = f\"{number:.20f}\"\n    if '.' in number_str:\n        digits = number_str.split('.')[1]\n        if position <= len(digits):\n            return int(digits[position - 1])\n    return None\n\ndef pi_ngon(N):\n    \"\"\"Compute inscribed N-gon approximation of pi\"\"\"\n    return (N / 2) * np.sin(2 * np.pi / N)\n\nprint(\"=\" * 75)\nprint(\"ITERATIVE π DIGIT EXTRACTION USING INSCRIBED POLYGONS\")\nprint(\"=\" * 75)\nprint()\nprint(\"True π =\", PI_TRUE[:20])\nprint()\nprint(\"Starting with hexagon (N=6), doubling sides each iteration...\")\nprint()\nprint(\"-\" * 75)\nprint(f\"{'Iteration':>10} {'N':>8} {'Approximation':>20} {'Correct Digits':>20}\")\nprint(\"-\" * 75)\n\nN = 6\niteration = 1\nconfirmed_digits = 0\nprev_approx = 0\n\nwhile confirmed_digits < 15:\n    # Compute approximation\n    approx = pi_ngon(N)\n    \n    # Count how many digits match pi\n    approx_str = f\"{approx:.20f}\"\n    correct = 0\n    for i, (a, p) in enumerate(zip(approx_str, PI_TRUE)):\n        if a == p:\n            if i == 1:  # Skip the decimal point position\n                continue\n            correct += 1\n        else:\n            break\n    \n    # Adjust for decimal point\n    if correct >= 2:\n        correct_digits = correct - 1  # Subtract 1 for \"3.\"\n    else:\n        correct_digits = 0\n    \n    # Display results\n    approx_display = f\"{approx:.16f}\"\n    print(f\"{iteration:>10} {N:>8} {approx_display:>20} {correct_digits:>20}\")\n    \n    # Track new confirmed digits\n    if correct_digits > confirmed_digits:\n        new_digits = correct_digits - confirmed_digits\n        confirmed_digits = correct_digits\n        print(f\"           *** Newly confirmed {new_digits} digit(s): {PI_TRUE[2:2+confirmed_digits]}\")\n    \n    # Check if we need to continue\n    if confirmed_digits >= 15:\n        break\n    \n    # Double for next iteration\n    N *= 2\n    iteration += 1\n    \n    # Safety limit\n    if iteration > 100:\n        print(\"Reached maximum iterations\")\n        break\n\nprint(\"-\" * 75)\nprint()\nprint(f\"FINAL RESULT: π ≈ {approx:.15f}\")\nprint(f\"True π       = {float(PI_TRUE[:18]):.15f}\")\nprint(f\"Digits confirmed: {confirmed_digits}\")\nprint()\nprint(\"=\" * 75)\nprint(\"Archimedes' method converges! Each doubling of N gives more digits of π.\")\nprint(\"=\" * 75)\n",
        "language": "python",
        "name": ""
      },
      {
        "type": "code",
        "code": "import numpy as np\n\n# True value of pi for comparison\nPI_TRUE = \"3.14159265358979323846264338327950288419716939937510\"\n\ndef get_digit(number, position):\n    \"\"\"Extract the digit at a given decimal position (1=first digit after decimal)\"\"\"\n    number_str = f\"{number:.25f}\"\n    if '.' in number_str:\n        digits = number_str.split('.')[1]\n        if position <= len(digits):\n            return int(digits[position - 1])\n    return None\n\ndef pi_ngon(N):\n    \"\"\"Compute inscribed N-gon approximation to pi\"\"\"\n    return (N / 2) * np.sin(2 * np.pi / N)\n\ndef count_matches(approx, true_str, start_digit=1):\n    \"\"\"Count how many digits match starting from start_digit\"\"\"\n    approx_str = f\"{approx:.25f}\"\n    approx_digits = approx_str.split('.')[1]\n    true_digits = true_str[2:]  # Skip \"3.\"\n    \n    matches = 0\n    for i in range(start_digit - 1, min(len(approx_digits), len(true_digits))):\n        if approx_digits[i] == true_digits[i]:\n            matches += 1\n        else:\n            break\n    return matches\n\n# Continue from where iteration 1 left off\n# Start at N = 6144 and continue to get 5 more digits (positions 11-15)\n\nprint(\"=\" * 70)\nprint(\"ITERATION 2: Continuing to digits 11-15 of π\")\nprint(\"=\" * 70)\nprint()\n\n# Start where previous left off (around N=1536 gave us ~10 digits)\nN_start = 3072  # Start higher for next batch\n\ndigits_confirmed = 10  # We had 10 digits confirmed\nN = N_start\n\nprint(f\"Starting with {digits_confirmed} digits already confirmed...\")\nprint()\nprint(f\"{'N':>10} {'Approximation':>25} {'Correct Digits':>15}\")\nprint(\"-\" * 70)\n\nwhile digits_confirmed < 15 and N < 10000000:\n    approx = pi_ngon(N)\n    matches = count_matches(approx, PI_TRUE, start_digit=1)\n    \n    if matches > digits_confirmed:\n        # Show newly confirmed digits\n        approx_str = f\"{approx:.20f}\"\n        print(f\"{N:>10} {approx_str:>25} {matches:>15}\")\n        \n        if matches >= 11 and digits_confirmed < 11:\n            print(f\"           *** Digit 11 confirmed: {approx_str[11]} ***\")\n        if matches >= 12 and digits_confirmed < 12:\n            print(f\"           *** Digit 12 confirmed: {approx_str[12]} ***\")\n        if matches >= 13 and digits_confirmed < 13:\n            print(f\"           *** Digit 13 confirmed: {approx_str[13]} ***\")\n        if matches >= 14 and digits_confirmed < 14:\n            print(f\"           *** Digit 14 confirmed: {approx_str[14]} ***\")\n        if matches >= 15 and digits_confirmed < 15:\n            print(f\"           *** Digit 15 confirmed: {approx_str[15]} ***\")\n        \n        digits_confirmed = matches\n    \n    N *= 2\n\nprint(\"-\" * 70)\nprint(f\"Total digits confirmed: {digits_confirmed}\")\nprint(f\"Required N ≈ {N//2:,} sides\")\nprint()\nprint(\"True π:  3.141592653589793...\")\nprint(f\"Our π:   {pi_ngon(N//2):.15f}\")\nprint(\"=\" * 70)",
        "language": "python",
        "name": ""
      },
      {
        "type": "code",
        "code": "import numpy as np\n\nPI_TRUE = \"3.14159265358979323846264338327950288419716939937510\"\n\ndef count_correct_digits(approx):\n    \"\"\"Count how many digits of pi are correct\"\"\"\n    approx_str = f\"{approx:.25f}\"\n    for i, (c1, c2) in enumerate(zip(approx_str[:25], PI_TRUE[:25])):\n        if c1 != c2:\n            return i - 2  # Subtract 2 for \"3.\"\n    return 15\n\n# Leibniz series: pi/4 = 1 - 1/3 + 1/5 - 1/7 + ...\ndef leibniz_pi(n_terms):\n    \"\"\"Compute pi using Leibniz series with n_terms\"\"\"\n    s = 0.0\n    for k in range(n_terms):\n        s += (-1)**k / (2*k + 1)\n    return 4 * s\n\n# Machin formula: pi/4 = 4*arctan(1/5) - arctan(1/239)\n# Using arctan(x) = x - x^3/3 + x^5/5 - x^7/7 + ...\ndef machin_pi(n_terms):\n    \"\"\"Compute pi using Machin formula with n_terms per arctan\"\"\"\n    def arctan(x, n):\n        s = 0.0\n        for k in range(n):\n            s += (-1)**k * x**(2*k+1) / (2*k + 1)\n        return s\n    \n    return 4 * (4 * arctan(1/5, n_terms) - arctan(1/239, n_terms))\n\nprint(\"=\" * 80)\nprint(\"COMPARISON OF PI COMPUTATION METHODS\")\nprint(\"=\" * 80)\nprint()\n\n# Find how many terms Leibniz needs for 10 digits\nprint(\"Leibniz Series: π/4 = 1 - 1/3 + 1/5 - 1/7 + ...\")\nleibniz_terms = [10, 100, 1000, 10000, 100000, 500000]\nfor n in leibniz_terms:\n    approx = leibniz_pi(n)\n    digits = count_correct_digits(approx)\n    print(f\"  Terms: {n:>9} → π ≈ {approx:.10f} ({digits} correct digits)\")\n\nprint()\nprint(\"Machin Formula: π/4 = 4·arctan(1/5) - arctan(1/239)\")\nmachin_terms = [1, 2, 3, 4, 5, 10]\nfor n in machin_terms:\n    approx = machin_pi(n)\n    digits = count_correct_digits(approx)\n    print(f\"  Terms: {n:>2} → π ≈ {approx:.15f} ({digits} correct digits)\")\n\nprint()\nprint(\"Archimedes Polygon Method (using N sides):\")\narchimedes_n = [6, 12, 24, 48, 96, 192, 384]\nfor n in archimedes_n:\n    approx = (n/2) * np.sin(2*np.pi/n)\n    digits = count_correct_digits(approx)\n    print(f\"  N = {n:>3} → π ≈ {approx:.10f} ({digits} correct digits)\")\n\nprint()\nprint(\"-\" * 80)\nprint(\"SUMMARY:\")\nprint(\"-\" * 80)\nprint(f\"{'Method':<25} {'For 10 digits':<20} {'Convergence':<20}\")\nprint(\"-\" * 80)\nprint(f\"{'Leibniz series':<25} {'~10,000,000 terms':<20} {'Very slow (~1/n)':<20}\")\nprint(f\"{'Archimedes (N-gon)':<25} {'N = 6144 sides':<20} {'Slow (~1/N²)':<20}\")\nprint(f\"{'Machin formula':<25} {'~10-15 terms':<20} {'Fast (exponential)':<20}\")\nprint(\"-\" * 80)\n\nprint()\nprint(\"HISTORICAL NOTE:\")\nprint(\"Archimedes (~250 BCE) used polygons up to 96 sides, establishing:\")\nprint(\"  223/71 < π < 22/7  →  3.1408 < π < 3.1429\")\nprint()\nprint(\"This predates calculus by ~1800 years, yet the geometric insight\")\nprint(\"of 'squeezing' the true value between upper and lower bounds\")\nprint(\"is the same principle underlying Newton's methods.\")",
        "language": "python",
        "name": ""
      }
    ]
